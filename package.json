{
  "name": "task-master",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm -r run dev",
    "build": "pnpm -r run build",
    "preview": "pnpm -r run preview",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "coverage": "pnpm -r run coverage",
    "docs:generate": "pnpm --filter @taskmaster/docs-tooling run generate",
    "clean": "shx rm -rf **/*.tsbuildinfo **/*.js **/*.d.ts **/dist **/coverage"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "shx": "^0.4.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "dotenv": "catalog:"
  }
}